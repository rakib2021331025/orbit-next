# ---------------------------------------------------------------------------
# Orbit Next — environment
#
# Copy to .env.local for development and set the same names in Vercel for
# production. NOTHING here may be prefixed NEXT_PUBLIC_ except values that are
# safe in the browser: anything with that prefix is compiled into the client
# bundle and is readable by every visitor.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# DATABASE_URL goes through the pooler (serverless-safe); DIRECT_URL is the
# unpooled connection Prisma Migrate needs. With Neon/Supabase both are given.
DATABASE_URL="postgresql://user:password@host:5432/orbit?sslmode=require&connection_limit=5&pool_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/orbit?sslmode=require"

# --- Authentication --------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL, used for absolute links in email and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage: Supabase Storage ------------------------------------------
# Files never go into PostgreSQL. The database stores only the path
# (uploads/materials/x.pdf); lib/storage/buckets.ts maps the folder to one of five
# buckets. Create them with: npx tsx tools/storage-setup.ts
# ORBIT_STORAGE: "supabase" in production; "local" (default) writes to public/uploads.
ORBIT_STORAGE="supabase"
# Not secret: the project URL (public bucket CDN links are built from it).
NEXT_PUBLIC_SUPABASE_URL=""
# SECRET. Server-only — bypasses Row Level Security. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Monitoring ----------------------------------------------------------------
# Log queries slower than this (ms). Defaults to 500 in development, off in production.
ORBIT_SLOW_QUERY_MS=""

# --- Email -----------------------------------------------------------------
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Orbit Private Care <no-reply@example.com>"

# --- Orbit Academic AI (Google Gemini) -------------------------------------
# Server-side only. The browser never sees the key or the model name.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash"

# --- Legacy import (only for the one-off MySQL → PostgreSQL migration) ------
# Read-only credentials for the original MySQL database. Never set in Vercel.
LEGACY_MYSQL_HOST="localhost"
LEGACY_MYSQL_USER="root"
LEGACY_MYSQL_PASSWORD=""
LEGACY_MYSQL_DATABASE="orbit_coaching"
LEGACY_MYSQL_PORT="3306"
# The offset the PHP app wrote DATETIMEs in (ORBIT_TZ_OFFSET in Orbit/config.php).
LEGACY_MYSQL_TZ="+06:00"

# --- First admin for `npm run db:seed` (fresh database only) ----------------
# Leave the password empty to have one generated and printed once.
SEED_ADMIN_EMAIL="admin@orbitprivatecare.com"
SEED_ADMIN_PASSWORD=""
