}

model TeacherBatch {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  batch      String   @db.VarChar(150)
  created_at DateTime @default(now())
  teacher    Teacher  @relation("TeacherBatch_teacher_id", fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, batch])
  @@map("teacher_batches")
}

model TeacherSubject {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  subject    String   @db.VarChar(150)
  created_at DateTime @default(now())
  teacher    Teacher  @relation("TeacherSubject_teacher_id", fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, subject])
  @@map("teacher_subjects")
}

model Teacher {
  id                     Int              @id @default(autoincrement())
  name                   String           @db.VarChar(255)
  name_bn                String?          @db.VarChar(255)
  email                  String           @unique @db.VarChar(255)
  phone                  String?          @db.VarChar(30)
  password_hash          String           @db.VarChar(255)
  designation            String?          @db.VarChar(150)
  designation_bn         String?          @db.VarChar(150)
  qualification          String?          @db.VarChar(255)
  qualification_bn       String?          @db.VarChar(255)
  experience             String?          @db.VarChar(200)
  experience_bn          String?          @db.VarChar(200)
  photo                  String?          @db.VarChar(255)
  bio                    String?          @db.Text
  bio_bn                 String?          @db.Text
  status                 TeacherStatus    @default(active)
  last_login             DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime         @default(now()) @updatedAt
  sort_order             Int              @default(0)
  show_on_website        Boolean          @default(false)
  branchTeacher_teacher  BranchTeacher[]  @relation("BranchTeacher_teacher_id")
  course_teacher         Course[]         @relation("Course_teacher_id")
  exam_teacher           Exam[]           @relation("Exam_teacher_id")
  liveClass_teacher      LiveClass[]      @relation("LiveClass_teacher_id")
  recordedClass_teacher  RecordedClass[]  @relation("RecordedClass_teacher_id")
  teacherBatch_teacher   TeacherBatch[]   @relation("TeacherBatch_teacher_id")
  teacherSubject_teacher TeacherSubject[] @relation("TeacherSubject_teacher_id")

  @@index([status])
  @@index([show_on_website, status, sort_order])
  @@map("teachers")
}

model TrialClass {
  id           Int               @id @default(autoincrement())
  title        String            @db.VarChar(255)
  teacher_name String?           @db.VarChar(255)
  course_name  String?           @db.VarChar(255)
  description  String?           @db.Text
  thumbnail    String?           @db.VarChar(255)
  video_url    String?           @db.VarChar(500)
  status       TrialClassStatus? @default(active)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @default(now()) @updatedAt

  @@map("trial_classes")
}

model UserPreference {
  id         Int                    @id @default(autoincrement())
  user_type  UserPreferenceUserType
  user_id    Int
  theme      UserPreferenceTheme    @default(light)
  updated_at DateTime               @default(now()) @updatedAt
  lang       String?                @db.VarChar(5)

  @@unique([user_type, user_id])
  @@map("user_preferences")
}

model VisitorLog {
  id                 Int                  @id @default(autoincrement())
  visitor_identifier String               @db.Char(32)
  session_id         String               @db.Char(32)
  page_url           String               @db.VarChar(191)
  visit_date         DateTime             @db.Date
  visit_time         DateTime             @db.Time(0)
  device_type        VisitorLogDeviceType @default(desktop)
  browser            String               @default("Other") @db.VarChar(30)
  is_new_visitor     Boolean              @default(false)
  created_at         DateTime

  @@index([visit_date, visitor_identifier, session_id, is_new_visitor])
  @@index([visit_date, page_url])
  @@index([created_at, visitor_identifier])
  @@map("visitor_logs")
}

model VisitorMonthlySummary {
  month_start      DateTime  @id @db.Date
  page_views       Int       @default(0)
  visits           Int       @default(0)
  unique_visitors  Int       @default(0)
  new_visitors     Int       @default(0)
  active_days      Int       @default(0)
  avg_daily_visits Decimal   @default(0) @db.Decimal(10, 2)
  peak_date        DateTime? @db.Date
  peak_visits      Int       @default(0)
  top_page         String?   @db.VarChar(191)
  top_page_views   Int       @default(0)
  created_at       DateTime  @default(now())

  @@map("visitor_monthly_summary")
}

