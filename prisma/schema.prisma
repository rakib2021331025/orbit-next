// Orbit Private Care — PostgreSQL schema for orbit-next.
//
// Generated from the original MySQL schema of the PHP app, table for table:
// 65 tables, 726 columns, 61 foreign keys, 62 enums. Field names keep their
// database spelling so every query in the original can be compared directly;
// models are PascalCase and carry @@map to the real table name.
//
// Do not edit by hand without re-checking against the original schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Achievement {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  image       String   @db.VarChar(255)
  created_at  DateTime @default(now())

  @@index([created_at])
  @@map("achievements")
}

model AdminNote {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  message    String?  @db.Text
  pdf_path   String   @db.VarChar(255)
  batch      String   @db.VarChar(100)
  created_by Int
  created_at DateTime @default(now())

  @@map("admin_notes")
}

model Admin {
  id                            Int             @id @default(autoincrement())
  name                          String?         @db.VarChar(191)
  email                         String          @unique @db.VarChar(255)
  password_hash                 String          @db.VarChar(255)
  created_at                    DateTime        @default(now())
  branch_id                     Int?
  role                          AdminRole       @default(super_admin)
  status                        AdminStatus     @default(active)
  last_login                    DateTime?
  created_by                    Int?
  updated_at                    DateTime?       @updatedAt
  branch                        Branch?         @relation("Admin_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignment_created_by_ref     Assignment[]    @relation("Assignment_created_by")
  studyMaterial_uploaded_by_ref StudyMaterial[] @relation("StudyMaterial_uploaded_by")

  @@index([branch_id])
  @@index([role, status])
  @@map("admins")
}

model Admission {
  id                   Int                     @id @default(autoincrement())
  application_no       String?                 @unique @db.VarChar(30)
  fullname             String                  @db.VarChar(255)
  fullname_bn          String?                 @db.VarChar(255)
  father_name          String                  @db.VarChar(255)
  mother_name          String                  @db.VarChar(255)
  mobile               String                  @db.VarChar(20)
  email                String?                 @db.VarChar(255)
  address              String                  @db.Text
  qualification        String                  @db.VarChar(255)
  course               String                  @db.VarChar(255)
  message              String?                 @db.Text
  created_at           DateTime                @default(now())
  guardian_phone       String?                 @db.VarChar(20)
  date_of_birth        DateTime?               @db.Date
  gender               AdmissionGender?
  institution          String?                 @db.VarChar(255)
  photo                String?                 @db.VarChar(255)
  course_id            Int?
  batch_id             Int?
  batch_label          String?                 @db.VarChar(150)
  batch_type           AdmissionBatchType?
  payment_method       AdmissionPaymentMethod?
  transaction_id       String?                 @db.VarChar(100)
  sender_number        String?                 @db.VarChar(20)
  payment_amount       Decimal?                @db.Decimal(10, 2)
  payment_screenshot   String?                 @db.VarChar(255)
  status               AdmissionStatus         @default(pending)
  review_note          String?                 @db.Text
  reviewed_at          DateTime?
  reviewed_by          Int?
  student_id           Int?
  updated_at           DateTime                @default(now()) @updatedAt
  applicant_student_id Int?
  student_id_input     String?                 @db.VarChar(30)
  enrollment_id        Int?
  approved_at          DateTime?
  rejected_at          DateTime?
  submitted_lang       String?                 @db.VarChar(5)
  branch_id            Int?
  branch               Branch?                 @relation("Admission_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment_admission Enrollment[]            @relation("Enrollment_admission_id")

  @@index([status])
  @@index([batch_id])
  @@index([mobile])
  @@index([created_at])
  @@index([transaction_id])
  @@index([student_id])
  @@index([applicant_student_id])
  @@index([branch_id, status, created_at])
  @@map("admissions")
}

model AiAnswerCache {
  question_hash String    @id @db.Char(64)
  question      String    @db.Text
  answer        String    @db.Text
  language      String    @default("en") @db.VarChar(10)
  hits          Int       @default(0)
  created_at    DateTime  @default(now())
  last_used_at  DateTime?

  @@index([created_at])
  @@map("ai_answer_cache")
}

model AiConversation {
  id                     Int         @id @default(autoincrement())
  student_id             Int
  title                  String?     @db.VarChar(191)
  created_at             DateTime    @default(now())
  updated_at             DateTime    @default(now()) @updatedAt
  student                Student     @relation("AiConversation_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aiMessage_conversation AiMessage[] @relation("AiMessage_conversation_id")

  @@index([student_id, updated_at])
  @@map("ai_conversations")
}

model AiMessage {
  id              Int            @id @default(autoincrement())
  conversation_id Int
  student_id      Int
  role            AiMessageRole
  content         String         @db.Text
  image_path      String?        @db.VarChar(255)
  tokens          Int?
  from_cache      Boolean        @default(false)
  created_at      DateTime       @default(now())
  conversation    AiConversation @relation("AiMessage_conversation_id", fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student         Student        @relation("AiMessage_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversation_id, id])
  @@index([student_id, role, created_at])
  @@map("ai_messages")
}

model AppSchemaVersion {
  id         Int      @id
  version    Int      @default(0)
  applied_at DateTime @default(now()) @updatedAt

  @@map("app_schema_version")
}

model AssignmentSubmission {
  id            Int        @id @default(autoincrement())
  assignment_id Int
  student_id    Int
  file_path     String     @db.VarChar(500)
  submitted_at  DateTime   @default(now())
  marks         Decimal?   @db.Decimal(5, 2)
  feedback      String?    @db.Text
  assignment    Assignment @relation("AssignmentSubmission_assignment_id", fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student       Student    @relation("AssignmentSubmission_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([assignment_id])
  @@index([student_id])
  @@map("assignment_submissions")
}

model Assignment {
  id                              Int                    @id @default(autoincrement())
  title                           String                 @db.VarChar(255)
  description                     String                 @db.Text
  course                          String                 @db.VarChar(255)
  batch                           String?                @db.VarChar(100)
  due_date                        DateTime               @db.Date
  file_path                       String?                @db.VarChar(500)
  created_by                      Int
  created_at                      DateTime               @default(now())
  branch_id                       Int?
  created_by_ref                  Admin                  @relation("Assignment_created_by", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch                          Branch?                @relation("Assignment_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignmentSubmission_assignment AssignmentSubmission[] @relation("AssignmentSubmission_assignment_id")

  @@index([created_by])
  @@index([course, due_date])
  @@index([branch_id])
  @@map("assignments")
}

model Attendance {
  id              Int               @id @default(autoincrement())
  student_id      Int
  course_id       Int?
  batch_id        Int               @default(0)
  attendance_date DateTime          @db.Date
  class_label     String?           @db.VarChar(150)
  status          AttendanceStatus? @default(present)
  note            String?           @db.VarChar(255)
  created_at      DateTime          @default(now())
  marked_by       Int?
  updated_at      DateTime?         @updatedAt
  branch_id       Int?
  student         Student           @relation("Attendance_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch          Branch?           @relation("Attendance_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([student_id, attendance_date, batch_id])
  @@index([batch_id, attendance_date])
  @@index([course_id, attendance_date])
  @@index([attendance_date, status])
  @@index([branch_id, attendance_date, status, student_id])
  @@index([attendance_date, branch_id, status, student_id])
  @@map("attendance")
}

model AuthRememberToken {
  id             Int                       @id @default(autoincrement())
  user_type      AuthRememberTokenUserType
  user_id        Int
  selector       String                    @unique @db.Char(32)
  validator_hash String                    @db.Char(64)
  expires_at     DateTime
  created_at     DateTime                  @default(now())
  last_used_at   DateTime?

  @@index([user_type, user_id])
  @@index([expires_at])
  @@map("auth_remember_tokens")
}

model Batch {
  id                      Int             @id @default(autoincrement())
  course_id               Int?
  name                    String          @db.VarChar(150)
  name_bn                 String?         @db.VarChar(150)
  batch_type              BatchBatchType  @default(offline)
  schedule_info           String?         @db.VarChar(255)
  schedule_info_bn        String?         @db.VarChar(255)
  start_date              DateTime?       @db.Date
  capacity                Int?
  fee                     Decimal?        @db.Decimal(10, 2)
  status                  BatchStatus     @default(active)
  sort_order              Int             @default(0)
  created_at              DateTime        @default(now())
  updated_at              DateTime        @default(now()) @updatedAt
  branch_id               Int?
  course                  Course?         @relation("Batch_course_id", fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch                  Branch?         @relation("Batch_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment_batch        Enrollment[]    @relation("Enrollment_batch_id")
  monthlyExam_batch       MonthlyExam[]   @relation("MonthlyExam_batch_id")
  recordedClass_batch_ref RecordedClass[] @relation("RecordedClass_batch_id")

  @@unique([course_id, branch_id, name, batch_type])
  @@index([course_id])
  @@index([batch_type])
  @@index([status])
  @@index([branch_id, status])
  @@map("batches")
}

model BranchCourse {
  branch_id  Int
  course_id  Int
  status     BranchCourseStatus @default(active)
  created_at DateTime           @default(now())
  branch     Branch             @relation("BranchCourse_branch_id", fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course     Course             @relation("BranchCourse_course_id", fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([branch_id, course_id])
  @@index([course_id, status])
  @@map("branch_courses")
}

model BranchTeacher {
  branch_id  Int
  teacher_id Int
  created_at DateTime @default(now())
  branch     Branch   @relation("BranchTeacher_branch_id", fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teacher    Teacher  @relation("BranchTeacher_teacher_id", fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([branch_id, teacher_id])
  @@index([teacher_id])
  @@map("branch_teachers")
}

model Branch {
  id                   Int             @id @default(autoincrement())
  name_bn              String          @db.VarChar(191)
  name_en              String          @db.VarChar(191)
  slug                 String          @unique @db.VarChar(80)
  address_bn           String?         @db.VarChar(500)
  address_en           String?         @db.VarChar(500)
  description_bn       String?         @db.Text
  description_en       String?         @db.Text
  phone                String?         @db.VarChar(30)
  email                String?         @db.VarChar(191)
  image                String?         @db.VarChar(255)
  map_url              String?         @db.VarChar(1000)
  status               BranchStatus    @default(active)
  is_main              Boolean         @default(false)
  sort_order           Int             @default(0)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @default(now()) @updatedAt
  admin_branch         Admin[]         @relation("Admin_branch_id")
  admission_branch     Admission[]     @relation("Admission_branch_id")
  assignment_branch    Assignment[]    @relation("Assignment_branch_id")
  attendance_branch    Attendance[]    @relation("Attendance_branch_id")
  batch_branch         Batch[]         @relation("Batch_branch_id")
  branchCourse_branch  BranchCourse[]  @relation("BranchCourse_branch_id")
  branchTeacher_branch BranchTeacher[] @relation("BranchTeacher_branch_id")
  classRoutine_branch  ClassRoutine[]  @relation("ClassRoutine_branch_id")
  exam_branch          Exam[]          @relation("Exam_branch_id")
  liveClass_branch     LiveClass[]     @relation("LiveClass_branch_id")
  notice_branch        Notice[]        @relation("Notice_branch_id")
  payment_branch       Payment[]       @relation("Payment_branch_id")
  recordedClass_branch RecordedClass[] @relation("RecordedClass_branch_id")
  student_branch       Student[]       @relation("Student_branch_id")
  studyMaterial_branch StudyMaterial[] @relation("StudyMaterial_branch_id")

  @@index([status, sort_order])
  @@map("branches")
}

model ClassRoutine {
  id           Int      @id @default(autoincrement())
  course       String   @db.VarChar(255)
  batch        String?  @db.VarChar(100)
  day_of_week  String   @db.VarChar(20)
  start_time   DateTime @db.Time(0)
  end_time     DateTime @db.Time(0)
  subject      String   @db.VarChar(255)
  teacher_name String   @db.VarChar(255)
  room_number  String?  @db.VarChar(50)
  created_at   DateTime @default(now())
  branch_id    Int?
  branch       Branch?  @relation("ClassRoutine_branch_id", fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([branch_id])
  @@map("class_routine")
}

model Course {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  name_bn              String?                @db.VarChar(255)
  description          String                 @db.Text
  image                String                 @db.VarChar(255)
  created_at           DateTime               @default(now())
  fee                  Decimal?               @db.Decimal(10, 2)
  duration             String?                @db.VarChar(100)
  status               CourseStatus           @default(active)
  sort_order           Int                    @default(0)
  short_description    String?                @db.VarChar(500)
  short_description_bn String?                @db.VarChar(500)
  description_bn       String?                @db.Text
  course_type          CourseCourseType       @default(offline)
  duration_bn          String?                @db.VarChar(100)
  batch_info           String?                @db.VarChar(255)
  batch_info_bn        String?                @db.VarChar(255)
  teacher_id           Int?
  instructor_name      String?                @db.VarChar(255)
  enrollment_status    CourseEnrollmentStatus @default(open)
  is_featured          Boolean                @default(false)
  updated_at           DateTime               @default(now()) @updatedAt
  teacher              Teacher?               @relation("Course_teacher_id", fields: [teacher_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  batch_course         Batch[]                @relation("Batch_course_id")
  branchCourse_course  BranchCourse[]         @relation("BranchCourse_course_id")
  enrollment_course    Enrollment[]           @relation("Enrollment_course_id")
  monthlyExam_course   MonthlyExam[]          @relation("MonthlyExam_course_id")

  @@index([status])
  @@index([course_type])
  @@index([enrollment_status])
  @@index([teacher_id])
  @@map("courses")
}

model DbBackup {
  id              Int            @id @default(autoincrement())
  filename        String         @unique @db.VarChar(255)
  scope           DbBackupScope  @default(full)
  tables_included String?        @db.Text
  table_count     Int            @default(0)
  row_count       Int            @default(0)
  file_size       BigInt         @default(0)
  db_size         BigInt         @default(0)
  status          DbBackupStatus
  error_message   String?        @db.Text
  duration_ms     Int?
  created_by      Int?
  created_at      DateTime       @default(now())

  @@index([created_at])
  @@map("db_backups")
}

model EmailLog {
  id            Int            @id @default(autoincrement())
  recipient     String         @db.VarChar(255)
  subject       String         @db.VarChar(255)
  template      String?        @db.VarChar(60)
  status        EmailLogStatus
  error_message String?        @db.Text
  related_type  String?        @db.VarChar(40)
  related_id    Int?
  student_id    Int?
  sent_by       Int?
  created_at    DateTime       @default(now())

  @@index([created_at])
  @@index([related_type, related_id])
  @@index([student_id])
  @@index([status, created_at])
  @@map("email_logs")
}

model Enrollment {
  id           Int                  @id @default(autoincrement())
  student_id   Int
  course_id    Int?
  batch_id     Int?
  admission_id Int?
  course_name  String?              @db.VarChar(255)
  batch_name   String?              @db.VarChar(150)
  batch_type   EnrollmentBatchType?
  fee          Decimal?             @db.Decimal(10, 2)
  status       EnrollmentStatus     @default(active)
  enrolled_at  DateTime?
  approved_at  DateTime?
  approved_by  Int?
  notes        String?              @db.Text
  created_at   DateTime             @default(now())
  updated_at   DateTime             @default(now()) @updatedAt
  admission    Admission?           @relation("Enrollment_admission_id", fields: [admission_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  batch        Batch?               @relation("Enrollment_batch_id", fields: [batch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  course       Course?              @relation("Enrollment_course_id", fields: [course_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  student      Student              @relation("Enrollment_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([student_id])
  @@index([course_id])
  @@index([batch_id])
  @@index([admission_id])
  @@index([status])
  @@map("enrollments")
}

model ExamAnswerFile {
  id            Int                    @id @default(autoincrement())
  attempt_id    Int
  question_id   Int?
  file_path     String                 @db.VarChar(255)
  original_name String?                @db.VarChar(255)
  file_type     ExamAnswerFileFileType @default(image)
  file_size     Int                    @default(0)
  sort_order    Int                    @default(0)
  created_at    DateTime               @default(now())
  attempt       ExamAttempt            @relation("ExamAnswerFile_attempt_id", fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question      ExamQuestion?          @relation("ExamAnswerFile_question_id", fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attempt_id])
  @@index([question_id])
  @@map("exam_answer_files")
}

model ExamAnswer {
  id              Int                       @id @default(autoincrement())
  attempt_id      Int
  question_id     Int
  selected_option ExamAnswerSelectedOption?
  answer_text     String?                   @db.Text
  is_correct      Boolean?
  awarded_marks   Decimal?                  @db.Decimal(5, 2)
  teacher_comment String?                   @db.Text
  updated_at      DateTime                  @default(now()) @updatedAt
  attempt         ExamAttempt               @relation("ExamAnswer_attempt_id", fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question        ExamQuestion              @relation("ExamAnswer_question_id", fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attempt_id, question_id])
  @@index([question_id])
  @@map("exam_answers")
}

model ExamAttempt {
  id                     Int                    @id @default(autoincrement())
  exam_id                Int
  student_id             Int
  started_at             DateTime?
  submitted_at           DateTime?
  submit_mode            ExamAttemptSubmitMode?
  status                 ExamAttemptStatus      @default(in_progress)
  mcq_score              Decimal                @default(0) @db.Decimal(6, 2)
  cq_score               Decimal                @default(0) @db.Decimal(6, 2)
  total_score            Decimal                @default(0) @db.Decimal(6, 2)
  teacher_comment        String?                @db.Text
  evaluated_by           Int?
  evaluated_at           DateTime?
  exam                   Exam                   @relation("ExamAttempt_exam_id", fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student                Student                @relation("ExamAttempt_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examAnswerFile_attempt ExamAnswerFile[]       @relation("ExamAnswerFile_attempt_id")
  examAnswer_attempt     ExamAnswer[]           @relation("ExamAnswer_attempt_id")

  @@unique([exam_id, student_id])
  @@index([student_id])
  @@index([status])
  @@map("exam_attempts")
}

model ExamQuestion {
  id                      Int                        @id @default(autoincrement())
  exam_id                 Int
  question_type           ExamQuestionQuestionType   @default(mcq)
  question_text           String                     @db.Text
  question_image          String?                    @db.VarChar(255)
  marks                   Decimal                    @default(1) @db.Decimal(5, 2)
  sort_order              Int                        @default(0)
  option_a                String?                    @db.VarChar(500)
  option_b                String?                    @db.VarChar(500)
  option_c                String?                    @db.VarChar(500)
  option_d                String?                    @db.VarChar(500)
  correct_option          ExamQuestionCorrectOption?
  created_at              DateTime                   @default(now())
  exam                    Exam                       @relation("ExamQuestion_exam_id", fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examAnswerFile_question ExamAnswerFile[]           @relation("ExamAnswerFile_question_id")
  examAnswer_question     ExamAnswer[]               @relation("ExamAnswer_question_id")

  @@index([exam_id])
  @@index([exam_id, sort_order])
  @@map("exam_questions")
}

model ExamResult {
  id              Int                 @id @default(autoincrement())
  student_id      Int
  exam_name       String              @db.VarChar(255)
  subject         String              @db.VarChar(255)
  marks_obtained  Decimal             @db.Decimal(5, 2)
  total_marks     Decimal             @db.Decimal(5, 2)
  grade           String?             @db.VarChar(10)
  feedback        String?             @db.Text
  exam_date       DateTime?           @db.Date
  created_at      DateTime            @default(now())
  monthly_exam_id Int?
  exam_subject_id Int?
  is_absent       Boolean             @default(false)
  entered_by      Int?
  updated_at      DateTime?           @updatedAt
  student         Student             @relation("ExamResult_student_id", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exam_subject    MonthlyExamSubject? @relation("ExamResult_exam_subject_id", fields: [exam_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  monthly_exam    MonthlyExam?        @relation("ExamResult_monthly_exam_id", fields: [monthly_exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_subject_id, student_id])
  @@index([student_id])
  @@index([monthly_exam_id])
  @@index([exam_date])
  @@map("exam_results")
}

model Exam {
  id                Int               @id @default(autoincrement())
  title             String            @db.VarChar(255)
  exam_type         ExamExamType      @default(mcq)
  subject           String            @db.VarChar(150)
  batch             String?           @db.VarChar(150)
  course            String?           @db.VarChar(150)
  teacher_id        Int?
  instructions      String?           @db.Text
  total_marks       Decimal           @default(0) @db.Decimal(6, 2)
  pass_marks        Decimal           @default(0) @db.Decimal(6, 2)
  duration_minutes  Int               @default(60)
  start_datetime    DateTime
  end_datetime      DateTime
  negative_marking  Decimal           @default(0) @db.Decimal(4, 2)
  allow_file_upload Boolean           @default(true)
  status            ExamStatus        @default(draft)
  result_published  Boolean           @default(false)
  created_by_type   ExamCreatedByType @default(admin)
  created_by        Int?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now()) @updatedAt
